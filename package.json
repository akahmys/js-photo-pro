{
  "name": "js-photo-pro",
  "private": true,
  "version": "3.11.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "check": "biome check",
    "check:fix": "biome check --write",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:deps": "npm audit",
    "audit:secrets": "betterleaks git --staged -c $([ -f .betterleaks.local.toml ] && echo .betterleaks.local.toml || echo .betterleaks.toml)",
    "audit:all": "betterleaks dir . -c $([ -f .betterleaks.local.toml ] && echo .betterleaks.local.toml || echo .betterleaks.toml)",
    "harness": "node scripts/check-compliance.js && biome check && tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "encoding-japanese": "^2.2.0",
    "exifr": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/encoding-japanese": "^2.2.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^4.1.10"
  }
}
